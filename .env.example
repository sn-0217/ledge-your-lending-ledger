# Supabase project URL and publishable key (safe to use in the browser).
# VITE_ is preferred; NEXT_PUBLIC_ aliases from Supabase examples are also supported.
# Configure Google as a sign-in provider in the Supabase dashboard.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Google Identity OAuth Client ID for the legacy Google Drive appData backup.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
